{
  "name": "llm-client",
  "module": "index.ts",
  "type": "module",
  "platform": "node",
  "scripts": {
    "bundle": "bun build --bundle --minify src/bin.tsx --outfile dist/bin.js --target node",
    "postbundle": "bun shim.ts && cp node_modules/yoga-wasm-web/dist/yoga.wasm dist",
    "compile": "bun build --compile dist/bin.js --outfile dist/bin",
    "build": "bun run bundle && bun run compile",
    "lint": "eslint src --fix"
  },
  "devDependencies": {
    "@types/bun": "^1.1.6",
    "@types/marked-terminal": "^6.1.1",
    "@types/react": "^18.3.3",
    "@types/screenshot-desktop": "^1.12.3",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "eslint": "8.x",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-typescript": "^0.14.0",
    "react-devtools-core": "^5.3.1"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^0.0.35",
    "@anthropic-ai/sdk": "^0.25.0",
    "ai": "^3.3.0",
    "ansi-escapes": "^7.0.0",
    "ansi-styles": "^6.2.1",
    "boxen": "^8.0.0",
    "chalk": "^5.3.0",
    "ink": "^5.0.1",
    "mdstream": "^0.1.1",
    "ora": "^8.0.1",
    "partial-json": "^0.1.7",
    "pastel": "^3.0.0",
    "react": "^18.3.1",
    "screenshot-desktop": "^1.15.0",
    "streaming-markdown": "^0.0.14",
    "terminal-image": "^3.0.0",
    "zod": "^3.23.8"
  }
}